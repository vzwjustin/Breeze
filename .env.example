# ─── Breeze environment ────────────────────────────────────────────────
NODE_ENV=development

# Postgres
DATABASE_URL=postgresql://breeze:breeze@localhost:5432/breeze

# Redis
REDIS_URL=redis://localhost:6379

# Auth
AUTH_SECRET=replace-with-openssl-rand
AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Data encryption (AES-256-GCM key, 32 bytes base64)
BREEZE_DATA_KEY=

# AI providers
BREEZE_AI_PROVIDER=
BREEZE_PLANNER_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_ORGANIZATION=
ANTHROPIC_API_KEY=
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_BASE_URL=
ANTHROPIC_VERSION=
# Google — canonical key; GOOGLE_AI_API_KEY and GEMINI_API_KEY are accepted as fallbacks
GOOGLE_API_KEY=
GOOGLE_AI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=

# File storage
BREEZE_FILES_ROOT=

# Object storage (S3-compatible)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=breeze-artifacts
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Trigger.dev
TRIGGER_PROJECT_ID=
TRIGGER_SECRET_KEY=

# Background worker (recipes, tasks, approvals, events). Set a strong secret for cron hits.
BREEZE_CRON_SECRET=
BREEZE_WORKER_INTERVAL_MS=30000
