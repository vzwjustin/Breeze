# ─── Breeze environment ────────────────────────────────────────────────
NODE_ENV=development

# Postgres
DATABASE_URL=postgresql://breeze:breeze@localhost:5432/breeze

# Redis
REDIS_URL=redis://localhost:6379

# Auth
AUTH_SECRET=replace-with-openssl-rand
AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Data encryption (AES-256-GCM key, 32 bytes base64)
BREEZE_DATA_KEY=

# AI providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
OPENROUTER_API_KEY=

# Object storage (S3-compatible)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=breeze-artifacts
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Trigger.dev
TRIGGER_PROJECT_ID=
TRIGGER_SECRET_KEY=
