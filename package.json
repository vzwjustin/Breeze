{
  "name": "breeze",
  "private": true,
  "version": "0.0.1",
  "description": "Breeze — web-first AI assistant platform.",
  "packageManager": "pnpm@9.7.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @breeze/db generate",
    "db:migrate": "pnpm --filter @breeze/db migrate"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.6.0"
  }
}
