// Breeze Prisma schema. Single source of truth for the relational model.
// See /BLUEPRINT.md §9 for rationale.
//
// How to apply changes:
//   pnpm --filter @breeze/db db:generate   # regenerate PrismaClient types
//   pnpm --filter @breeze/db db:migrate    # create and apply a new migration (dev only)
//   pnpm --filter @breeze/db db:studio     # open Prisma Studio GUI

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Users & sessions (NextAuth v5 / Auth.js compatible) ─────────────────────

enum Role {
  USER
  ADMIN
}

model User {
  id                String         @id @default(cuid())
  email             String         @unique
  name              String?
  image             String?
  role              Role           @default(USER)
  preferences       Json?
  /// Builtin profile id (e.g. builtin.auto_run_safe_actions) or custom PolicyProfile cuid.
  policyProfileKey  String?
  policyProfileId   String?
  policyProfile     PolicyProfile? @relation("UserPolicyProfile", fields: [policyProfileId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts          Account[]
  sessions          Session[]
  chats             Chat[]
  tasks             Task[]
  approvals         Approval[]
  connectorAccounts ConnectorAccount[]
  memories          Memory[]
  auditEvents       AuditEvent[]
  auditLogs         AuditLog[]
  policyProfiles    PolicyProfile[]    @relation("PolicyProfileOwner")
  recipes           Recipe[]
  scheduledTasks    ScheduledTask[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Chat & messages ──────────────────────────────────────────────────────────

model Chat {
  id         String    @id @default(cuid())
  userId     String
  title      String
  summary    String?
  archivedAt DateTime?
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]
  plans     Plan[]
  artifacts Artifact[]

  @@index([userId])
  @@index([userId, updatedAt])
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

model Message {
  id        String      @id @default(cuid())
  chatId    String
  role      MessageRole
  content   Json
  tokens    Int?
  createdAt DateTime    @default(now())

  chat Chat  @relation(fields: [chatId], references: [id], onDelete: Cascade)
  plan Plan?

  @@index([chatId])
  @@index([chatId, createdAt])
}

// ─── Plans & steps ────────────────────────────────────────────────────────────

enum PlanStatus {
  RUNNING
  COMPLETED
  FAILED
  CANCELED
}

enum RiskLevel {
  NONE
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum StepKind {
  RETRIEVE
  SUMMARIZE
  DRAFT
  ACT
  WAIT
}

enum StepStatus {
  PENDING
  RUNNING
  AWAITING_APPROVAL
  COMPLETED
  FAILED
  SKIPPED
}

model Plan {
  id          String     @id @default(cuid())
  chatId      String
  messageId   String     @unique
  intent      String
  summaryText String
  riskLevel   RiskLevel
  status      PlanStatus @default(RUNNING)
  createdAt   DateTime   @default(now())

  chat    Chat       @relation(fields: [chatId], references: [id], onDelete: Cascade)
  message Message    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  steps   PlanStep[]
  runs    TaskRun[]

  @@index([chatId])
}

// PlanRow is exposed as an alias in application code — the underlying model is Plan.
// Use Plan directly in Prisma queries.

model PlanStep {
  id               String     @id @default(cuid())
  planId           String
  index            Int
  kind             StepKind
  capability       String?
  input            Json
  expectedArtifact String?
  riskLevel        RiskLevel
  status           StepStatus @default(PENDING)
  resultSummary    String?
  errorMessage     String?
  createdAt        DateTime   @default(now())

  plan       Plan              @relation(fields: [planId], references: [id], onDelete: Cascade)
  approvals  Approval[]
  executions ActionExecution[]

  @@index([planId])
  @@index([planId, index])
}

// ─── Tasks (scheduled / recurring) ───────────────────────────────────────────

enum TaskStatus {
  ACTIVE
  PAUSED
  FAILED
  ARCHIVED
}

enum RunStatus {
  RUNNING
  COMPLETED
  FAILED
  CANCELED
  WAITING_APPROVAL
}

model Task {
  id              String     @id @default(cuid())
  userId          String
  name            String
  description     String?
  schedule        Json
  prompt          String
  policyProfileId String?
  approvalMode    String     @default("policy") // per_run | once_on_create | policy
  status          TaskStatus @default(ACTIVE)
  lastRunAt       DateTime?
  nextRunAt       DateTime?
  triggerTaskId   String?
  deletedAt       DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs TaskRun[]

  @@index([userId])
  @@index([userId, status])
}

model TaskRun {
  id           String    @id @default(cuid())
  taskId       String
  triggerRunId String?   @unique
  status       RunStatus @default(RUNNING)
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  summary      String?
  planId       String?
  errorMessage String?

  task Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  plan Plan? @relation(fields: [planId], references: [id])

  @@index([taskId])
  @@index([taskId, startedAt(sort: Desc)])
}

// ScheduledTask is a lightweight cron-style entry used by the scheduler process
// to track next-fire times independently of user-facing Tasks.
model ScheduledTask {
  id          String    @id @default(cuid())
  userId      String
  taskId      String?   // optional link to Task
  name        String
  cronExpr    String?   // null for one-shot
  tz          String    @default("UTC")
  nextRunAt   DateTime
  lastRunAt   DateTime?
  enabled     Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([nextRunAt])
}

// ─── Approvals ────────────────────────────────────────────────────────────────

enum ApprovalStatus {
  PENDING
  APPROVED
  DENIED
  EXPIRED
  SUPERSEDED
  CANCELED
}

model Approval {
  id            String         @id @default(cuid())
  userId        String
  planStepId    String
  actionRequest Json
  preview       Json
  risk          RiskLevel
  status        ApprovalStatus @default(PENDING)
  expiresAt     DateTime
  decidedAt     DateTime?
  decisionNote  String?
  waitToken     String?        @unique
  createdAt     DateTime       @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planStep PlanStep @relation(fields: [planStepId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status, expiresAt])
}

// ─── Action executions (idempotent mutation record) ───────────────────────────

model ActionExecution {
  id             String    @id @default(cuid())
  planStepId     String
  capability     String
  connectorKey   String
  input          Json
  output         Json?
  errorMessage   String?
  idempotencyKey String    @unique
  startedAt      DateTime  @default(now())
  endedAt        DateTime?

  planStep PlanStep @relation(fields: [planStepId], references: [id], onDelete: Cascade)

  @@index([planStepId])
}

// ─── Connectors ───────────────────────────────────────────────────────────────

enum ConnectorStatus {
  ACTIVE
  NEEDS_REAUTH
  DISCONNECTED
  ERROR
}

model ConnectorAccount {
  id                String          @id @default(cuid())
  userId            String
  connectorKey      String
  providerAccountId String
  scopes            String[]
  status            ConnectorStatus @default(ACTIVE)
  lastSyncAt        DateTime?
  lastErrorAt       DateTime?
  lastError         String?
  deletedAt         DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  credential ConnectorCredential?

  @@unique([userId, connectorKey])
  @@index([userId])
}

// encryptedTokens holds the AES-256-GCM ciphertext blob (see packages/db/src/crypto.ts).
// Layout: [version (1) | iv (12) | tag (16) | ciphertext].
// Rotate keys by running packages/db/scripts/rotate-keys.ts.
model ConnectorCredential {
  id              String    @id @default(cuid())
  accountId       String    @unique
  encryptedTokens Bytes                   // full OAuth token bundle, encrypted
  keyVersion      Int       @default(1)
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  account ConnectorAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

// ─── Recipes (IFTTT-style trigger → actions) ──────────────────────────────────

enum RecipeStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

model Recipe {
  id            String       @id @default(cuid())
  userId        String
  name          String
  description   String?
  trigger       Json         // { key, input, pollSeconds }
  actions       Json         // RecipeAction[]
  approvalMode  String       @default("policy") // per_item | once_on_create | policy
  status        RecipeStatus @default(ACTIVE)
  cursor        String?
  lastRunAt     DateTime?
  nextRunAt     DateTime?
  triggerTaskId String?
  deletedAt     DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs    RecipeRun[]
  cursors RecipeCursor[]

  @@index([userId])
  @@index([userId, status])
  @@index([nextRunAt])
}

model RecipeRun {
  id           String    @id @default(cuid())
  recipeId     String
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  cursorBefore String?
  cursorAfter  String?
  items        Json      @default("[]") // RecipeRunItemResult[]
  errorMessage String?

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
  @@index([recipeId, startedAt(sort: Desc)])
}

// RecipeCursor persists the stable polling cursor between runs per trigger key,
// allowing multiple triggers on the same Recipe to advance independently.
model RecipeCursor {
  id         String   @id @default(cuid())
  recipeId   String
  triggerKey String
  cursor     String
  updatedAt  DateTime @updatedAt

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([recipeId, triggerKey])
  @@index([recipeId])
}

// ─── Memory ───────────────────────────────────────────────────────────────────

enum MemoryType {
  CONVERSATION
  USER
  WORKING
}

enum MemoryVisibility {
  USER_VISIBLE
  INTERNAL
}

model Memory {
  id         String           @id @default(cuid())
  userId     String
  type       MemoryType
  scope      String?
  key        String
  value      Json
  source     Json
  reason     String
  visibility MemoryVisibility @default(USER_VISIBLE)
  expiresAt  DateTime?
  deletedAt  DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, type])
}

// ─── Artifacts ────────────────────────────────────────────────────────────────

model Artifact {
  id         String   @id @default(cuid())
  chatId     String?
  planStepId String?
  kind       String
  payload    Json
  blobKey    String?
  createdAt  DateTime @default(now())

  chat Chat? @relation(fields: [chatId], references: [id], onDelete: SetNull)

  @@index([chatId])
}

// ─── Policy ───────────────────────────────────────────────────────────────────

model PolicyProfile {
  id        String   @id @default(cuid())
  userId    String?
  name      String
  kind      String   // "builtin" | "custom"
  rules     Json     // PolicyRule[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner    User?  @relation("PolicyProfileOwner", fields: [userId], references: [id], onDelete: Cascade)
  adopters User[] @relation("UserPolicyProfile")

  @@index([userId])
}

// ─── Audit & outbox ───────────────────────────────────────────────────────────

model AuditEvent {
  id            String   @id @default(cuid())
  userId        String?
  type          String
  subjectType   String?
  subjectId     String?
  correlationId String?
  data          Json
  createdAt     DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([correlationId])
}

// AuditLog is a structured append-only record for compliance purposes.
// Each row captures the actor, action, and resource that changed.
model AuditLog {
  id           String   @id @default(cuid())
  userId       String?
  action       String   // e.g. "connector.connected", "approval.granted"
  resourceType String?
  resourceId   String?
  meta         Json     @default("{}")
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([resourceType, resourceId])
}

model EventOutbox {
  id          String    @id @default(cuid())
  type        String
  payload     Json
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([publishedAt])
}
